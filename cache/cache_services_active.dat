a:2:{s:5:"value";a:6:{i:0;a:6:{s:2:"id";i:1;s:5:"title";s:8:"Sampling";s:11:"description";s:425:"We carry out precise sampling and joint sample preparation as per Indian Standards (IS) or International Standards (ISO, ASTM, etc). As per client requirement from on-site sampling of mines, plants & ports as well as in-house laboratory testing. We are dedicated to mitigating risks associated with the movement of commodities through all modes of transport or stacks, ensuring utmost reliability and accuracy at every stage.";s:4:"icon";s:13:"bi-eyedropper";s:9:"is_active";i:1;s:10:"created_at";s:19:"2025-12-16 22:38:58";}i:1;a:6:{s:2:"id";i:2;s:5:"title";s:10:"Inspection";s:11:"description";s:255:"We are committed to delivering our best with professionals for Pre-Shipment Assessment, Loading/Unloading Supervision, and Physical Quality Monitoring during Inspection. Our services include Weighment Assessment, Vessel, Rake, Trucks and Stack Assessment.";s:4:"icon";s:9:"bi-search";s:9:"is_active";i:1;s:10:"created_at";s:19:"2025-12-16 22:38:58";}i:2;a:6:{s:2:"id";i:3;s:5:"title";s:7:"Testing";s:11:"description";s:363:"We undertake analysis with our testing partners having NABL ISO/IEC 17025:2017 Testing Laboratories of Coal, Coke, Minerals, Ores, Fertilizers, Oil Cakes/Extractions, Metals, Agricultural Products, Environmental Testing, etc. Our team consists of well-qualified, experienced Technical and Professional persons including Mining Engineers, Scientists, and Chemists.";s:4:"icon";s:18:"bi-clipboard-check";s:9:"is_active";i:1;s:10:"created_at";s:19:"2025-12-16 22:38:58";}i:3;a:6:{s:2:"id";i:4;s:5:"title";s:10:"IT Support";s:11:"description";s:277:"We provide comprehensive IT support services including network management, hardware troubleshooting, software installation, system maintenance, and technical helpdesk support. Our experienced IT professionals ensure your business technology runs smoothly with minimal downtime.";s:4:"icon";s:13:"bi-pc-display";s:9:"is_active";i:1;s:10:"created_at";s:19:"2025-12-16 22:54:15";}i:4;a:6:{s:2:"id";i:5;s:5:"title";s:27:"Web Application Development";s:11:"description";s:235:"Our team delivers custom web application development services using modern technologies. We create responsive, scalable, and secure web applications tailored to your business needs, from simple websites to complex enterprise solutions.";s:4:"icon";s:8:"bi-globe";s:9:"is_active";i:1;s:10:"created_at";s:19:"2025-12-16 22:54:15";}i:5;a:6:{s:2:"id";i:6;s:5:"title";s:17:"Digital Marketing";s:11:"description";s:228:"Boost your online presence with our digital marketing services including SEO, social media marketing, content marketing, PPC advertising, and email campaigns. We help you reach your target audience and grow your business online.";s:4:"icon";s:12:"bi-megaphone";s:9:"is_active";i:1;s:10:"created_at";s:19:"2025-12-16 22:54:15";}}s:7:"expires";i:1783706791;}