# Production Environment Configuration
# Copy this to .env and update values for your production server

# Environment
ENVIRONMENT=production
DEBUG=false

# Site URL (no trailing slash)
SITE_URL=https://accredited.co.in

# Database Configuration (MariaDB)
DB_HOST=localhost
DB_NAME=agency_db
DB_USER=agency_user
DB_PASS=CHANGE_THIS_TO_SECURE_PASSWORD

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_EMAIL=noreply@accredited.co.in
SMTP_FROM_NAME=Accredited Inspection Agency
ADMIN_EMAIL=admin@accredited.co.in
